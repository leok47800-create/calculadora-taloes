rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null && request.auth.token.email_verified == true; }
    function admin() { return logado() && request.auth.token.email == 'leok47800@gmail.com'; }
    function liberado() {
      return admin() || (logado() && exists(/databases/$(database)/documents/config/acesso)
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/acesso).data.emails);
    }
    match /config/acesso { allow read, write: if admin(); }
    match /taloes/{id} { allow read, write: if liberado(); }
  }
}
